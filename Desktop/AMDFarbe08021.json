    ],
    "cpu_profile_path": "SDR sRGB XR24 8bpc Full or Limited, 100-nit reference white",
    "hardware_gamma_lut_entries": 0,
    "hardware_degamma_lut_entries": 0,
    "hardware_ctm": false,
    "vrr_implemented": false,
    "vrr_publication": "known/fixed reason=unavailable; DCN1 DRR capability is not a completed qualified adaptive link and frame-time controller",
    "dsc": false,
    "dp_mst": false,
    "frl": false,
    "scdc": false
  },
  "boundaries": [
    "MMIO/DMA/EDID/ATOM/frame responses in AMD tests are explicit software stimuli, not GPU or link measurements.",
    "Native R4AMD handles existing NV12/P010/YUV input conversion and linear FP16 composition; AMDGPU scanout is RGB XR24/XR30, not FP16 or native YCbCr.",
    "ICC plus HDR/10-bit and hardware LUT/CTM are not implemented. RGB6 eDP does not advertise a fabricated RGB8 color state.",
    "VRR remains an explicit implementation gap; no physical absence of GPU capability is inferred.",
    "No physical probes, laptop updates or Windows execution; HDR/10-bit receiver and electrical link verification only /39.",
    "AMDGPU IMAGE_SCOPE=none until /37; auto/passive does not activate GPU. No new global test group. Existing upstream DP macro warnings remain; actual builds exit zero."
  ]
}
