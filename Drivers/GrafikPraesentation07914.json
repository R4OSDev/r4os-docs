{
  "recorded_at_utc": "2026-09-13T03:57:14.0120032Z",
  "status": "0.79.14 OPEN: hardware head-event entry integrated and host modeled; flip receipt/queues, cursor and common visible statistics still open.",
  "release": "0.79.13",
  "nvidia": "0.1.95",
  "kernel": "0.1.161",
  "scope": "Actual native Device enables GSP-reported display stall IRQ after acknowledged native handoff. One existing IRQ owner handles GSP and active-head LAST_DATA; bounded per-head snapshots carry observed-event sequence, monotonic IRQ observation time and raw hardware frame/line position.",
  "binding": "Real post-init display entry and stall vector, distinct from GSP; actual RM head count and active mode head. No PCI scan, second MSI setup, new kernel/ABI or change to default passive bootfb. Normal GSP-only paths remain intact.",
  "concurrency": "Single gate serializes IRQ service, display enable and retirement. Immutable fields publish before delivery. Per-head atomic seqlock reads have at most three attempts; IRQ updates metadata and signals one existing semaphore. No task-owned lock, BO mutation/free, RM dispatch or log in IRQ. Cached read-only monotonic clock uses existing IRQ-independent kernel clock source where available; it never fabricates an event.",
  "failure": "Unknown head/cause remains unacknowledged, latches IRQ failure and prevents rearm. Closing blocks the display leaf and clears only owned LAST_DATA enable bits before unregister/mapping release. Physical uncertainty keeps the original display and DMA owners in existing quarantine.",
  "diagnostics": "DISPLAYD /NVIDIA head-events exposes enable source and first actual event per head. Sequence is count of observed causes, not an absolute display counter. Time is CPU monotonic IRQ observation; frame/scanline comes from RG_DPCA. There is no visible-completion or buffer-release inference yet.",
  "validation": {
    "checks": {
      "build-final.log": "7/7 steps succeeded",
      "unit-combined.log": "13/13 steps succeeded; 51/51 tests passed"
    },
    "device": "Existing Device fixture tests real endpoint on shared INTx: two heads, empty source, counter wrap, GSP/display concurrency with one wake and no RPC/range activity, vector alias rejection, unowned cause left untouched and complete IRQ close retaining DMA. Existing native product cases also traverse automatic source enable after common handoff.",
    "new_gate": false,
    "limits": "GPU/MMIO response behavior is modeled in host RAM; source acknowledgements are explicitly injected. No physical VBlank, real displayed flip, actual IRQ latency or image/cursor acceptance. Existing GSP close-race/failed-unregister cases remain active. No new guest run."
  },
  "open_software": [
    "Actual flip-notifier/interrupt admission and separate visible completion",
    "Double/triple buffering, bounded queue and acquire/render/flip/retirement ownership",
    "Deadline/backpressure and missing-event policy",
    "Hardware cursor plus software fallback integration",
    "Shared per-head/visible Present statistics"
  ],
