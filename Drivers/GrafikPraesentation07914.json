{
  "recorded_at_utc": "2026-09-13T04:23:03.3705204Z",
  "status": "0.79.14 OPEN: native head IRQ and same-mode Window flip entry implemented and host modeled; ordinary Present pool, shared visible statistics and cursor still open.",
  "release": "0.79.13",
  "nvidia": "0.1.96",
  "kernel": "0.1.161",
  "scope": "Actual Device head IRQ owner plus serialized native Window flip entry. Inactive images require completed private CE upload. Window UPDATE omits Core interlock and preserves mode, HDMI and position. The normal Present pool does not yet call this entry.",
  "binding": "Real post-init display entry and stall vector, distinct from GSP; actual RM head count and active mode head. No PCI scan, second MSI setup, new kernel/ABI or change to default passive bootfb. Normal GSP-only paths remain intact.",
  "concurrency": "Single gate serializes IRQ service, display enable and retirement. Immutable fields publish before delivery. Per-head atomic seqlock reads have at most three attempts; IRQ updates metadata and signals one existing semaphore. No task-owned lock, BO mutation/free, RM dispatch or log in IRQ. Cached read-only monotonic clock uses existing IRQ-independent kernel clock source where available; it never fabricates an event.",
  "failure": "One pending flip blocks conflicting mode/copy/table work. Missing head IRQ, Window BEGUN or old FINISHED reaches its finite deadline retaining both allocations. GPU notifier status cannot be replaced by GET, CPU time or IRQ alone. Existing IRQ unknown-cause/close quarantine remains active.",
  "diagnostics": "Per-head latest flip receipt separates render point, Window point, raw GPU timestamp, monotonic submit/observation time, observed head sequence and previous-image scanout release. The last field permits reuse, not allocator release. Existing queue fences and copy counters remain unchanged. Failure detail uses the existing NVIDIA bootlog.",
  "validation": {
    "device": "Actual native Device creates, imports and maps a second same-mode image, uploads with CE, submits a Window-only flip, consumes actual head IRQ snapshots and Window records, flips back, then retires mapping/RAMHT/native owners. Command fetch alone, empty IRQ, each IRQ/BEGUN order, Busy conflicts and all three missing-event deadline cases checked. Core/HDMI/RPC and common-copy counters remain unchanged across flips. Final run also blocks catalog/mode worker entry while flip is pending.",
    "limits": "Hardware responses and pixels are modeled. No physical output, real IRQ latency, tearing/cursor or performance claim. Existing test groups only; no new guest run. Ordinary Present remains direct-copy until pool integration.",
    "checks": {
      "build-final.log": "7/7 steps succeeded",
      "unit-serialized.log": "13/13 steps succeeded; 51/51 tests passed"
    },
    "new_gate": false
  },
  "open_software": [
    "Normal Present integration with shared-shadow double/triple buffering and bounded queue",
    "Accumulated damage and separate acquire/render/flip/reuse ownership across mode apply/confirm/rollback",
    "Hardware cursor plus software fallback integration",
    "Shared per-head/visible Present statistics"
  ],
